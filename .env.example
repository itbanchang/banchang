# ============================================================
# BCH 360° Intelligence V.10 — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# MySQL — App-local replica (default profile "slave1")
# ⚠️ RECOMMENDED: Use a SELECT-ONLY user for security hardening
# Create with: GRANT SELECT ON bchhosxpxe.* TO 'bch_readonly'@'%';
MYSQL_HOST=10.109.0.33
MYSQL_DB=bchhosxpxe
MYSQL_USER=your_user
MYSQL_PASS=your_password
MYSQL_PORT=3306

# MySQL Master (HOSxP primary) — optional, only needed if MYSQL_SERVER=master
# MYSQL_MASTER_HOST=10.109.0.240
# MYSQL_MASTER_DB=bchhosxpxe
# MYSQL_MASTER_USER=your_master_user
# MYSQL_MASTER_PASS=your_master_password
# MYSQL_MASTER_PORT=3306

# MySQL Slave2 (HOSxP secondary replica) — optional, only needed if MYSQL_SERVER=slave2
# MYSQL_SLAVE2_HOST=10.1.0.239
# MYSQL_SLAVE2_DB=bchhosxpxe
# MYSQL_SLAVE2_USER=your_slave2_user
# MYSQL_SLAVE2_PASS=your_slave2_password
# MYSQL_SLAVE2_PORT=3306

# Active profile selector — slave1 (default) | master | slave2
# MYSQL_SERVER=slave1

# Circuit Breaker — max query execution time (ms)
# Queries exceeding this are KILLED on the MySQL server
# QUERY_TIMEOUT_MS=10000

# Server Ports
DEV_PORT=3001
PROD_PORT=3000

# JWT Authentication Secrets (REQUIRED — server will not start without JWT_SECRET)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Access token: short-lived (30 minutes)
JWT_SECRET=change-me-to-random-64-char-hex-string
# Refresh token: long-lived (24 hours) - use different secret for security
REFRESH_TOKEN_SECRET=change-me-to-another-random-64-char-hex-string

# Server IP (for CORS whitelist — defaults to 10.109.0.33)
# SERVER_IP=10.109.0.33

# ⚠️ CRITICAL: Default Users
# IMPORTANT: These MUST be changed immediately after first deployment
# If using in-memory users (not database), set these securely:
# DEFAULT_ADMIN_PASSWORD=change-me-immediately-after-deploy
# DEFAULT_DIRECTOR_PASSWORD=change-me-immediately-after-deploy
# Recommended: Migrate to database-backed users for production

# Claude AI (Anthropic) — Revenue Forecast Narrative + DRG Analysis
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Logging & Debugging
LOG_LEVEL=info
NODE_ENV=production
