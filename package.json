{
  "name": "bch-360-intelligence",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"DEV-NODE,DEV-VITE\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/server.js",
    "clean:dist": "node -e \"import('fs').then(({rmSync,mkdirSync})=>{rmSync('./dist/assets',{recursive:true,force:true});mkdirSync('./dist/assets',{recursive:true});console.log('✅ dist/assets cleaned')})\"",
    "build": "npm run clean:dist && vite build",
    "build:clean": "npm run clean:dist && vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "production": "node server/production.js",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 50",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "deploy": "bash scripts/deploy.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop all",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:logs": "pm2 logs bch360-server",
    "pm2:monit": "pm2 monit",
    "health": "bash scripts/health-check.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "bullmq": "^5.71.0",
    "compression": "^1.8.1",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.18.2",
    "node-cron": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "recharts": "^2.12.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "uuid": "^9.0.0",
    "winston": "^3.14.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8"
  }
}
