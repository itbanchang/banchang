{
  "name": "bch-360-intelligence",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"DEV-NODE,DEV-VITE\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/server.js",
    "clean:dist": "node --input-type=module -e \"import{readdirSync,unlinkSync}from'node:fs';import{join}from'node:path';const d='./dist/assets';try{for(const f of readdirSync(d))unlinkSync(join(d,f));}catch{}console.log('dist/assets cleaned')\"",
    "build": "npm run clean:dist && vite build",
    "build:clean": "npm run clean:dist && vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "production": "node server/production.js",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 50",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy/deploy.ps1",
    "deploy:setup": "powershell -ExecutionPolicy Bypass -File deploy/setup_ssh_key.ps1",
    "deploy:dry": "powershell -ExecutionPolicy Bypass -File deploy/deploy.ps1 -DryRun",
    "deploy:watch": "powershell -ExecutionPolicy Bypass -File deploy/watch.ps1 -NoInitialDeploy",
    "deploy:watch-now": "powershell -ExecutionPolicy Bypass -File deploy/watch.ps1",
    "deploy:bg": "powershell -ExecutionPolicy Bypass -File deploy/bgctl.ps1 start",
    "deploy:bg:stop": "powershell -ExecutionPolicy Bypass -File deploy/bgctl.ps1 stop",
    "deploy:bg:restart": "powershell -ExecutionPolicy Bypass -File deploy/bgctl.ps1 restart",
    "deploy:bg:status": "powershell -ExecutionPolicy Bypass -File deploy/bgctl.ps1 status",
    "deploy:bg:log": "powershell -ExecutionPolicy Bypass -File deploy/bgctl.ps1 log",
    "deploy:shortcuts": "powershell -ExecutionPolicy Bypass -File deploy/create_shortcuts.ps1",
    "deploy:legacy": "bash scripts/deploy.sh",
    "promote": "bash scripts/promote.sh",
    "promote:force": "bash scripts/promote.sh --force",
    "promote:dry": "bash scripts/promote.sh --dry-run",
    "promote:staging": "bash scripts/promote-staging.sh",
    "promote:staging:force": "bash scripts/promote-staging.sh --force",
    "promote:safe-rotate:install": "bash scripts/install-safe-rotate-cron.sh",
    "rollback": "bash scripts/rollback.sh",
    "rollback:list": "bash scripts/rollback.sh --list",
    "lint:check": "bash scripts/lint-check.sh",
    "lint:baseline": "bash scripts/lint-check.sh --update",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop all",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:logs": "pm2 logs bch360-server",
    "pm2:monit": "pm2 monit",
    "health": "bash scripts/health-check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:smoke": "node scripts/smoke_test.mjs",
    "validate:schema": "node scripts/validate_schema.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "docker:build": "docker build -t bch360 .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "compression": "^1.8.1",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.18.2",
    "node-cron": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "recharts": "^2.12.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "uuid": "^9.0.0",
    "winston": "^3.14.2",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.2",
    "vite": "^5.0.8",
    "vitest": "^4.1.1"
  }
}
