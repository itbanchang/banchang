{
  "name": "bch-360-intelligence",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"DEV-NODE,DEV-VITE\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/server.js",
    "clean:dist": "node -e \"import('fs').then(({rmSync,mkdirSync})=>{rmSync('./dist/assets',{recursive:true,force:true});mkdirSync('./dist/assets',{recursive:true});console.log('✅ dist/assets cleaned')})\"",
    "build": "npm run clean:dist && vite build",
    "build:clean": "npm run clean:dist && vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "production": "node server/production.js",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 50",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "deploy": "bash scripts/deploy.sh",
    "promote": "bash scripts/promote.sh",
    "promote:force": "bash scripts/promote.sh --force",
    "promote:dry": "bash scripts/promote.sh --dry-run",
    "promote:staging": "bash scripts/promote-staging.sh",
    "promote:staging:force": "bash scripts/promote-staging.sh --force",
    "promote:safe-rotate:install": "bash scripts/install-safe-rotate-cron.sh",
    "rollback": "bash scripts/rollback.sh",
    "rollback:list": "bash scripts/rollback.sh --list",
    "lint:check": "bash scripts/lint-check.sh",
    "lint:baseline": "bash scripts/lint-check.sh --update",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop all",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:logs": "pm2 logs bch360-server",
    "pm2:monit": "pm2 monit",
    "health": "bash scripts/health-check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "eval": "node eval/runners/index.js",
    "metrics:docs": "node server/metrics/generate-docs.mjs",
    "dq:run": "node --env-file=.env -e \"import('./server/dq/index.js').then(m => m.runAllChecks()).then(r => { console.log(JSON.stringify(r.summary, null, 2), '\\n status:', r.status); process.exit(r.status === 'danger' ? 1 : 0); })\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "bullmq": "^5.71.0",
    "compression": "^1.8.1",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.18.2",
    "node-cron": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "recharts": "^2.12.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "uuid": "^9.0.0",
    "winston": "^3.14.2",
    "web-vitals": "^4.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.2",
    "vite": "^5.0.8",
    "vitest": "^4.1.1"
  }
}
