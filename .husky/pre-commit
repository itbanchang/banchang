# Pre-commit hook — lint-staged + secret scan
# Bypass (emergencies only): git commit --no-verify
# Husky v9 — no shebang/sourcing line needed

# Don't run on rebase / merge / cherry-pick
if [ -f .git/MERGE_MSG ] || [ -f .git/CHERRY_PICK_HEAD ] || [ -f .git/REBASE_HEAD ]; then
  exit 0
fi

# Run lint-staged (ESLint + Prettier on staged files only)
npx lint-staged

# Secret scan — block commits containing common secret patterns.
echo "🔍 Scanning for secrets..."
PATTERNS='AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|sk-(ant-)?[A-Za-z0-9_-]{40,}|BEGIN (RSA )?PRIVATE KEY'
FOUND=$(git diff --cached --name-only -z | xargs -0 grep -lE "$PATTERNS" 2>/dev/null || true)

if [ -n "$FOUND" ]; then
  echo "❌ Possible secret detected in staged files:"
  echo "$FOUND" | sed 's/^/   /'
  echo
  echo "If this is a false positive, bypass with: git commit --no-verify"
  exit 1
fi

echo "✅ Pre-commit checks passed"
